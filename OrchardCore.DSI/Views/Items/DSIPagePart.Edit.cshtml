@using OrchardCore
@model DSIPageViewModel

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="ValidatedRoles" class="@Orchard.GetLabelClasses()">@T["Validated Roles"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="ValidatedRoles" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["Type the user rules you need for access this page."]</span>
    </div>
</div>

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="InvalidRedirectUrl" class="@Orchard.GetLabelClasses()">@T["InvalidRedirectUrl"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="InvalidRedirectUrl" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The Invalid Redirect Url."]</span>
    </div>
</div>