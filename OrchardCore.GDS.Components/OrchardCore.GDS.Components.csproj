<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="OrchardCore.DisplayManagement.Abstractions" Version="3.0.1" />
		<PackageReference Include="OrchardCore.DisplayManagement.Liquid" Version="3.0.1" />
		<PackageReference Include="OrchardCore.Flows" Version="3.0.1" />
		<PackageReference Include="OrchardCore.Forms" Version="3.0.1" />
		<PackageReference Include="OrchardCore.Module.Targets" Version="3.0.1" />
		<PackageReference Include="OrchardCore.ContentManagement" Version="3.0.1" />
		<PackageReference Include="OrchardCore.ContentTypes.Abstractions" Version="3.0.1" />
		<PackageReference Include="OrchardCore.DisplayManagement" Version="3.0.1" />
		<PackageReference Include="OrchardCore.Workflows" Version="3.0.1" />
		<PackageReference Include="OrchardCore.Workflows.Abstractions" Version="3.0.1" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Migrations\gds.recipe.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Update="Views\UploadBlobFileTask.Fields.Design.cshtml">
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Migrations\Templates\" />
	</ItemGroup>

</Project>
