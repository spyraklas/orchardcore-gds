<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Storage.Blobs" Version="12.25.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="OrchardCore.DisplayManagement.Abstractions" Version="2.1.7" />
		<PackageReference Include="OrchardCore.DisplayManagement.Liquid" Version="2.1.7" />
		<PackageReference Include="OrchardCore.Flows" Version="2.1.7" />
		<PackageReference Include="OrchardCore.Forms" Version="2.1.7" />
		<PackageReference Include="OrchardCore.Module.Targets" Version="2.1.7" />
		<PackageReference Include="OrchardCore.ContentManagement" Version="2.1.7" />
		<PackageReference Include="OrchardCore.ContentTypes.Abstractions" Version="2.1.7" />
		<PackageReference Include="OrchardCore.DisplayManagement" Version="2.1.7" />
		<PackageReference Include="OrchardCore.Workflows" Version="2.1.7" />
		<PackageReference Include="OrchardCore.Workflows.Abstractions" Version="2.1.7" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Migrations\gds.recipe.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Update="Views\UploadBlobFileTask.Fields.Design.cshtml">
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Migrations\Templates\" />
	</ItemGroup>

</Project>
