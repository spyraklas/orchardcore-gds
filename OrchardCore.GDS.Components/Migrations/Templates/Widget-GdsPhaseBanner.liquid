{% assign part = Model.ContentItem.Content.GdsPhaseBanner %}

<div class="govuk-phase-banner">
  <p class="govuk-phase-banner__content">
    <strong class="govuk-tag govuk-phase-banner__content__tag {{ part.LabelClass.Text }}">
      {{ part.Label.Text }}
    </strong>
    <span class="govuk-phase-banner__text">
      {{ part.Description.Html | raw }}
    </span>
  </p>
</div>