{% assign style = Model.ContentItem.Content.GdsRowColumns.Style.Text %}
{% assign leftColumn = "" %}
{% assign rightColumn = "" %}

{% case style %}
  {% when "one-half" %}
     {% assign leftColumn = "one-half" %}
     {% assign rightColumn = "one-half" %}
  {% when "two-thirds" %}
     {% assign leftColumn = "two-thirds" %}
     {% assign rightColumn = "one-third" %}
  {% when "one-third" %}
     {% assign leftColumn = "one-third" %}
     {% assign rightColumn = "two-thirds" %}
  {% when "three-quarters" %}
     {% assign leftColumn = "three-quarters" %}
     {% assign rightColumn = "one-quarter" %}
  {% when "one-quarter" %}
     {% assign leftColumn = "one-quarter" %}
     {% assign rightColumn = "three-quarters" %}
{% endcase %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-{{ leftColumn }}">
    {% for item in Model.ContentItem.Content.LeftColumn.Widgets %}
        {{ item | shape_build_display: "Detail" | shape_render }}
    {% endfor %}
  </div>
  <div class="govuk-grid-column-{{ rightColumn }}">
    {% for item in Model.ContentItem.Content.RightColumn.Widgets %}
        {{ item | shape_build_display: "Detail" | shape_render }}
    {% endfor %}    
  </div>
</div>