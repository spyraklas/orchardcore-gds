@model BlobFilesEditSettingsViewModel

<div class="ocat-wrapper">
    <label asp-for="FileTypesAllowed" class="ocat-label">@T["File Types Allowed"]</label>
    <div class="ocat-end">
        <input asp-for="FileTypesAllowed" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["Comma seperate file extensions allowed for upload (example: .pdf,.jpg,.jpeg,.png,.gif)."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="FileSizeAllowed" class="ocat-label">@T["File Size Allowed"]</label>
    <div class="ocat-end">
        <input asp-for="FileSizeAllowed" type="number" class="form-control content-preview-text" />
        <span class="hint">@T["Maximum file size allowed for upload (in bytes)."]</span>
    </div>
</div>

<fieldset class="mb-3" asp-validation-class-for="WithDownload">
    <div class="form-check">
        <input asp-for="WithDownload" class="form-check-input" type="checkbox" />
        <label asp-for="WithDownload" class="form-check-label">@T["With Download File Action"]</label>
    </div>
    <span class="hint">@T["File can be downloaded"]</span>
</fieldset>

<fieldset class="mb-3" asp-validation-class-for="WithRemove">
    <div class="form-check">
        <input asp-for="WithRemove" class="form-check-input" type="checkbox" />
        <label asp-for="WithRemove" class="form-check-label">@T["With Remove File Action"]</label>
    </div>
    <span class="hint">@T["File can be removed"]</span>
</fieldset>
