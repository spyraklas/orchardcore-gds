@using OrchardCore
@model GdsCssPartViewModel

<div class="ocat-wrapper">
    <label asp-for="CssClass" class="ocat-label">@T["Css Class Attribute"]</label>
    <div class="ocat-end">
        <input asp-for="CssClass" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The class attribute of the html element."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="CssStyle" class="ocat-label">@T["Css Style Attribute"]</label>
    <div class="ocat-end">
        <input asp-for="CssStyle" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The style attribute of the html element."]</span>
    </div>
</div>