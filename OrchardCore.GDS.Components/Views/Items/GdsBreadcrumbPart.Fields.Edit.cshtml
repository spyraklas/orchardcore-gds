@using OrchardCore
@model GdsBreadcrumbPartViewModel

<div class="ocat-wrapper">
    <label asp-for="Value" class="ocat-label">@T["Value"]</label>
    <div class="ocat-end">
        <input asp-for="Value" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The value for this breadcrumb."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Href" class="ocat-label">@T["Href"]</label>
    <div class="ocat-end">
        <input asp-for="Href" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The href attribute for the breadcrumb."]</span>
    </div>
</div>