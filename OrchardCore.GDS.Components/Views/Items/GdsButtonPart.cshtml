@model GdsButtonPartViewModel

@{
    var formElementPart = Model.ContentItem.Get<FormElementPart>(nameof(FormElementPart));
    var elementId = formElementPart?.Id;

    var buttonClass = "govuk-button";
    if(Model.Disabled)
    {
        buttonClass += " govuk-button--disabled";
    }
    buttonClass += " " + Model.Style + " " + Model.Class;

    var addOnClick = Model.OnClick?.Length > 0;
    var addTarget = Model.Target?.Length > 0;
}

@if (Model.Style?.ToLower() == "govuk-button--start")
{
    <a id="@elementId" href="@Model.Href" @(addTarget ? Html.Raw(@$"target=""{Model.Target}""") : "") role="button" draggable="false" class="@buttonClass" data-module="govuk-button" @(addOnClick ? Html.Raw(@$"onclick=""{Model.OnClick}""") : "") >
        @Model.Value
        <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
        </svg>
    </a>
}
else
{
    <button id="@elementId" name="@elementId" type="@Model.Type" @(Model.PreventDoubleClick ? Html.Raw(@$"data-prevent-double-click=""true""") : "") class="@buttonClass" data-module="govuk-button" @(addOnClick ? Html.Raw(@$"onclick=""{Model.OnClick}""") : "") @(Model.Disabled ? Html.Raw(@$"disabled=""disabled"" aria-disabled=""true""") : "") >
        @Model.Value
    </button>
}


