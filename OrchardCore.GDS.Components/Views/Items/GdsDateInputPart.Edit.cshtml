@using OrchardCore
@model GdsDateInputPartViewModel

<div class="ocat-wrapper">
    <label asp-for="DayValue" class="ocat-label">@T["Day Value"]</label>
    <div class="ocat-end">
        <input asp-for="DayValue" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The day value for this field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="MonthValue" class="ocat-label">@T["Month Value"]</label>
    <div class="ocat-end">
        <input asp-for="MonthValue" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The month value for this field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="YearValue" class="ocat-label">@T["Year Value"]</label>
    <div class="ocat-end">
        <input asp-for="YearValue" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The year value for this field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="AutoComplete" class="ocat-label">@T["AutoComplete Text"]</label>
    <div class="ocat-end">
        <input asp-for="AutoComplete" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The auto complete name attribute for this field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="DaySessionKey" class="ocat-label">@T["Day Session Key"]</label>
    <div class="ocat-end">
        <input asp-for="DaySessionKey" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The session key value for day where application store a value for this field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="MonthSessionKey" class="ocat-label">@T["Month Session Key"]</label>
    <div class="ocat-end">
        <input asp-for="MonthSessionKey" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The session key value for month where application store a value for this field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="YearSessionKey" class="ocat-label">@T["Year Session Key"]</label>
    <div class="ocat-end">
        <input asp-for="YearSessionKey" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The session key value for year where application store a value for this field."]</span>
    </div>
</div>
