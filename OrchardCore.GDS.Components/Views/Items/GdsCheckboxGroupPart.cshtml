@using OrchardCore.ContentManagement.Display;
@using OrchardCore.Flows.Models;
@using OrchardCore.GDS.Session.Helpers;

@model GdsCheckboxGroupPartViewModel
@inject IContentItemDisplayManager ContentItemDisplayManager
@inject ISessionHelper sessionHelper

@{
    var formElementPart = Model.ContentItem.Get<FormElementPart>(nameof(FormElementPart));
    var formInputElementPart = Model.ContentItem.Get<FormInputElementPart>(nameof(FormInputElementPart));
    var bagPart = Model.ContentItem.Get<BagPart>(nameof(BagPart));
    var cssPart = Model.ContentItem.Get<GdsCssPart>(nameof(GdsCssPart));
    var labelPart = Model.ContentItem.Get<GdsLabelPart>(nameof(GdsLabelPart));
    var hintPart = Model.ContentItem.Get<GdsHintPart>(nameof(GdsHintPart));

    var elementId = formElementPart.Id;
    var fieldName = formInputElementPart.Name;
    var fieldId = !String.IsNullOrEmpty(elementId) ? elementId : !String.IsNullOrEmpty(fieldName) ? Html.GenerateIdFromName(fieldName) : default(string);
    var sessionValue = Model.SessionKey?.Length > 0 ? sessionHelper.GetSessionValue(Model.SessionKey) : "";

    var groupClass = "govuk-form-group";
    var withHint = hintPart.Hint?.Length > 0;
    bool withError = false;
    var checkboxDivClass = "govuk-checkboxes";

    if (Model.SmallCheckboxes)
    {
        checkboxDivClass += " govuk-checkboxes--small";
    }

    if (ViewData.ModelState.TryGetValue(fieldName, out var fieldEntry))
    {
        sessionValue = fieldEntry.AttemptedValue;

        if (fieldEntry.Errors.Count > 0)
        {
            withError = true;
            groupClass += " govuk-form-group--error";
        }
    }

    sessionValue = sessionValue ?? "";
    string[] sessionValueArray = (sessionValue.Length > 0 ? sessionValue.Split(',') : new string[0])
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToArray();
}

<div id="@fieldId-group" @Html.Raw(Html.BuildCssAttributes(cssPart, groupClass))>
    @if (Model.Autosave)
    {
        @sessionHelper.SessionKeyField(fieldName, Model.SessionKey);
    }
    <fieldset class="govuk-fieldset" @(withHint ? Html.Raw(@$"aria-describedby=""{fieldId}-hint""") : withError ? Html.Raw(@$"aria-describedby=""{fieldId}-error""") : "")>
        <legend class="@Html.GetFieldsetClass(labelPart.LabelSize) @labelPart.LabelClass">
            @if (labelPart.LabelStyle == "label")
            {
                @labelPart.Label
            }
            else
            {
                @Html.Raw(Html.StartLabelRapperTag(labelPart.LabelStyle, $"govuk-fieldset__heading"))
                @labelPart.Label
                @Html.Raw(@Html.EndLabelRapperTag(labelPart.LabelStyle))
            }
        </legend>
        @if (withHint)
        {
            <div id="@fieldId-hint" class="govuk-hint">
                @Html.Raw(hintPart.Hint)
            </div>
        }
        @if (withError)
        {
            @foreach (var error in fieldEntry.Errors)
            {
                <p id="@fieldId-error" class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span> @error.ErrorMessage
                </p>
            }
        }

        <div class="@checkboxDivClass" data-module="govuk-checkboxes">
            @foreach (var item in bagPart.ContentItems)
            {
                if (item.ContentType == "GdsCheckbox")
                {
                    var part = item.ContentItem.Get<GdsCheckboxPart>(nameof(GdsCheckboxPart));
                    var checkboxFormElementPart = item.ContentItem.Get<FormElementPart>(nameof(FormElementPart));
                    var checkboxCssPart = item.ContentItem.Get<GdsCssPart>(nameof(GdsCssPart));
                    var checkboxJsPart = item.ContentItem.Get<GdsJsPart>(nameof(GdsJsPart));
                    var checkboxHintPart = item.ContentItem.Get<GdsHintPart>(nameof(GdsHintPart));
                    var checkboxElementId = checkboxFormElementPart.Id;
                    var withCheckboxHint = checkboxHintPart.Hint?.Length > 0;
                    var checkboxChecked = string.Empty;
                    if (!string.IsNullOrEmpty(sessionValue))
                        checkboxChecked = sessionValueArray.Contains(part.Value.Trim().TrimEnd(','), StringComparer.OrdinalIgnoreCase) ? "checked" : "";
                    else
                        checkboxChecked = part.Selected ? "checked" : "";

                    <div class="govuk-checkboxes__item">
                        <input id="@checkboxElementId" name="@fieldName" type="checkbox" value="@part.Value" @(part.ConditionalFlow ? Html.Raw($@"data-aria-controls=""conditional-{checkboxElementId}""") : "") @Html.Raw(Html.BuildCssAttributes(checkboxCssPart, "govuk-checkboxes__input")) @Html.Raw(Html.BuildJsAttributes(checkboxJsPart)) @checkboxChecked>
                        <label class="govuk-label govuk-checkboxes__label @part.LabelClass" for="@checkboxElementId">
                            @part.Label
                        </label>
                        @if (withCheckboxHint)
                        {
                            <div id="@checkboxElementId-hint" class="govuk-hint govuk-checkboxes__hint @checkboxHintPart.HintClass">
                                @checkboxHintPart.Hint
                            </div>
                        }
                        @if (part.ConditionalFlow)
                        {
                            var flowPart = item.ContentItem.Get<FlowPart>(nameof(FlowPart));
                            var widgetContent = await ContentItemDisplayManager.BuildDisplayAsync(flowPart.ContentItem, Model.BuildPartDisplayContext.Updater, "Detail", Model.BuildPartDisplayContext.GroupId);

                            <div class="govuk-checkboxes__conditional govuk-checkboxes__conditional--hidden" id="conditional-@checkboxElementId">
                                @await DisplayAsync(widgetContent)
                            </div>
                        }
                    </div>
                }
                else if (item.ContentType == "GdsCheckboxDivider")
                {
                    var part = item.ContentItem.Get<GdsCheckboxDividerPart>(nameof(GdsCheckboxDividerPart));
                    var cssPartDivider = item.ContentItem.Get<GdsCssPart>(nameof(GdsCssPart));

                    <div class="govuk-checkboxes__divider @cssPartDivider.CssClass" @(cssPartDivider.CssStyle?.Length > 0 ? @$"style=""{cssPartDivider.CssStyle}""" : "")>@Html.Raw(@part.Value)</div>
                }

            }
        </div>
    </fieldset>
</div>