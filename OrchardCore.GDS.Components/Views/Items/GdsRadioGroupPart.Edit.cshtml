@model GdsRadioGroupPartViewModel

<fieldset class="mb-3" asp-validation-class-for="Inline">
    <div class="form-check">
        <input asp-for="Inline" class="form-check-input" type="checkbox" />
        <label asp-for="Inline" class="form-check-label">@T["Inline radios"]</label>
    </div>
    <span class="hint">@T["Inline radios display buttons."]</span>
</fieldset>

<fieldset class="mb-3" asp-validation-class-for="SmallRadios">
    <div class="form-check">
        <input asp-for="SmallRadios" class="form-check-input" type="checkbox" />
        <label asp-for="SmallRadios" class="form-check-label">@T["Small radio buttons"]</label>
    </div>
    <span class="hint">@T["Display small size radio buttons."]</span>
</fieldset>

<div class="ocat-wrapper">
    <label asp-for="SessionKey" class="ocat-label">@T["Session Key"]</label>
    <div class="ocat-end">
        <input asp-for="SessionKey" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The session key value where application store a value for this field."]</span>
    </div>
</div>