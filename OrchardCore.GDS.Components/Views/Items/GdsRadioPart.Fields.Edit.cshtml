@using OrchardCore
@model GdsRadioPartViewModel

<div class="ocat-wrapper">
    <label asp-for="Value" class="ocat-label">@T["Value"]</label>
    <div class="ocat-end">
        <input asp-for="Value" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The value for this field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Label" class="ocat-label">@T["Label Text"]</label>
    <div class="ocat-end">
        <input asp-for="Label" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The text for the label field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="LabelClass" class="ocat-label">@T["Label Class Attribute"]</label>
    <div class="ocat-end">
        <input asp-for="LabelClass" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The class attribute for the label field."]</span>
    </div>
</div>

<fieldset class="mb-3" asp-validation-class-for="Selected">
    <div class="form-check">
        <input asp-for="Selected" class="form-check-input" type="checkbox" />
        <label asp-for="Selected" class="form-check-label">@T["Selected"]</label>
    </div>
    <span class="hint">@T["If radio button is selected."]</span>
</fieldset>

<fieldset class="mb-3" asp-validation-class-for="ConditionalFlow">
    <div class="form-check">
        <input asp-for="ConditionalFlow" class="form-check-input" type="checkbox" />
        <label asp-for="ConditionalFlow" class="form-check-label">@T["Enable conditional flow"]</label>
    </div>
    <span class="hint">@T["Enable conditional flow for the radio button."]</span>
</fieldset>