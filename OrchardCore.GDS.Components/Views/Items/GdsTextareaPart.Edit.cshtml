@using OrchardCore
@model GdsTextareaPartViewModel

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="Value" class="@Orchard.GetLabelClasses()">@T["Value"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="Value" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The value for this field."]</span>
    </div>
</div>

<fieldset class="mb-3" asp-validation-class-for="SpellCheck">
    <div class="form-check">
        <input asp-for="SpellCheck" class="form-check-input" type="checkbox" />
        <label asp-for="SpellCheck" class="form-check-label">@T["Enable spell check"]</label>
    </div>
    <span class="hint">@T["Whether textarea perform spell check."]</span>
</fieldset>

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="Rows" class="@Orchard.GetLabelClasses()">@T["Number of rows"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="Rows" type="number" class="form-control content-preview-text" />
        <span class="hint">@T["Number of rows for the textarea field."]</span>
    </div>
</div>

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="Count" class="@Orchard.GetLabelClasses()">@T["Count"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="Count" type="number" class="form-control content-preview-text" />
        <span class="hint">@T["Count limit for the textarea field."]</span>
    </div>
</div>

<fieldset class="mb-3" asp-validation-class-for="CountWords">
    <div class="form-check">
        <input asp-for="CountWords" class="form-check-input" type="checkbox" />
        <label asp-for="CountWords" class="form-check-label">@T["Enable word count"]</label>
    </div>
    <span class="hint">@T["Whether count should be in words. (Unchecked will count characters)"]</span>
</fieldset>

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="SessionKey" class="@Orchard.GetLabelClasses()">@T["Session Key"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="SessionKey" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The session key value where application store a value for this field."]</span>
    </div>
</div>