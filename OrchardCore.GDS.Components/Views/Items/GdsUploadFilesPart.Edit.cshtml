@using OrchardCore
@model GdsUploadFilesPartViewModel

<div class="ocat-wrapper">
    <label asp-for="UploadAction" class="ocat-label">@T["Upload Action"]</label>
    <div class="ocat-end">
        <input asp-for="UploadAction" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["Form action for uploading blob files"]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="ButtonValue" class="ocat-label">@T["Button Value"]</label>
    <div class="ocat-end">
        <input asp-for="ButtonValue" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["Form submit button value"]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="FileTypesAllowed" class="ocat-label">@T["File Types Allowed"]</label>
    <div class="ocat-end">
        <input asp-for="FileTypesAllowed" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["Comma seperate file extensions allowed for upload (example: .pdf,.jpg,.jpeg,.png,.gif)."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="FilesSessionKey" class="ocat-label">@T["Files Session Key"]</label>
    <div class="ocat-end">
        <input asp-for="FilesSessionKey" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["Files session key that contain the reference of the azure blob folder containing the uploaded files"]</span>
    </div>
</div>

<fieldset class="mb-3" asp-validation-class-for="WithDownload">
    <div class="form-check">
        <input asp-for="WithDownload" class="form-check-input" type="checkbox" />
        <label asp-for="WithDownload" class="form-check-label">@T["With Download Action"]</label>
    </div>
    <span class="hint">@T["Files can be downloaded"]</span>
</fieldset>

<div class="ocat-wrapper">
    <label asp-for="DownloadAction" class="ocat-label">@T["Download Action"]</label>
    <div class="ocat-end">
        <input asp-for="DownloadAction" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["Form action for downloading blob files"]</span>
    </div>
</div>

<fieldset class="mb-3" asp-validation-class-for="WithRemove">
    <div class="form-check">
        <input asp-for="WithRemove" class="form-check-input" type="checkbox" />
        <label asp-for="WithRemove" class="form-check-label">@T["With Remove Action"]</label>
    </div>
    <span class="hint">@T["Files can be removed"]</span>
</fieldset>

<div class="ocat-wrapper">
    <label asp-for="RemoveAction" class="ocat-label">@T["Remove Action"]</label>
    <div class="ocat-end">
        <input asp-for="RemoveAction" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["Form action for removing blob files"]</span>
    </div>
</div>