@using OrchardCore
@model GdsAccordionSectionPartViewModel

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="Id" class="@Orchard.GetLabelClasses()">@T["Id"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="Id" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The id for this element."]</span>
    </div>
</div>

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="Class" class="@Orchard.GetLabelClasses()">@T["Class"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="Class" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The class for this element."]</span>
    </div>
</div>

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="Title" class="@Orchard.GetLabelClasses()">@T["Title"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="Title" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The title for this element."]</span>
    </div>
</div>

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="TitleStyle" class="@Orchard.GetLabelClasses()">@T["Title Style"]</label>
    <div class="@Orchard.GetEndClasses()">
        <select asp-for="TitleStyle" class="form-select content-preview-select field-type-select-menu">
            <option value="label">@T["Label"]</option>
            <option value="h1">@T["Header 1"]</option>
            <option value="h2">@T["Header 2"]</option>
            <option value="h3">@T["Header 3"]</option>
            <option value="h4">@T["Header 4"]</option>
            <option value="h5">@T["Header 5"]</option>
            <option value="h6">@T["Header 6"]</option>
        </select>
        <span class="hint">@T["The title style."]</span>
    </div>
</div>

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="TitleClass" class="@Orchard.GetLabelClasses()">@T["Title Class Attribute"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="TitleClass" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The class attribute for the title field."]</span>
    </div>
</div>

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="Summary" class="@Orchard.GetLabelClasses()">@T["Summary Text"]</label>
    <div class="@Orchard.GetEndClasses()">
        <textarea asp-for="Summary" rows="5" class="form-control content-preview-text"></textarea>
        <span class="hint">@T["The text or html for the summary element."]</span>
    </div>
</div>

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="SummaryClass" class="@Orchard.GetLabelClasses()">@T["Summary Class Attribute"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="SummaryClass" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The class attribute for the summary of this element."]</span>
    </div>
</div>
