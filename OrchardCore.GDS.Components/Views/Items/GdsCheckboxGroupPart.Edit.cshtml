@model GdsCheckboxGroupPartViewModel

<fieldset class="mb-3" asp-validation-class-for="SmallCheckboxes">
    <div class="form-check">
        <input asp-for="SmallCheckboxes" class="form-check-input" type="checkbox" />
        <label asp-for="SmallCheckboxes" class="form-check-label">@T["Small checkbox buttons"]</label>
    </div>
    <span class="hint">@T["Display small size checkbox buttons."]</span>
</fieldset>

<div class="ocat-wrapper">
    <label asp-for="SessionKey" class="ocat-label">@T["Session Key"]</label>
    <div class="ocat-end">
        <input asp-for="SessionKey" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The session key value where application store a value for this field."]</span>
    </div>
</div>