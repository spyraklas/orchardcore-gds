@using OrchardCore
@model GdsJsPartViewModel

<div class="ocat-wrapper">
    <label asp-for="OnChange" class="ocat-label">@T["OnChange Attribute"]</label>
    <div class="ocat-end">
        <input asp-for="OnChange" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The onchange attribute of the html element."]</span>
    </div>
</div>

