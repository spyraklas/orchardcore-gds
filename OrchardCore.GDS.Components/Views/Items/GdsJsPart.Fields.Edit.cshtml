@using OrchardCore
@model GdsJsPartViewModel

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="OnChange" class="@Orchard.GetLabelClasses()">@T["OnChange Attribute"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="OnChange" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The onchange attribute of the html element."]</span>
    </div>
</div>

