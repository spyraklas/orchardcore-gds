@using OrchardCore
@model GdsInputTextPartViewModel

<div class="ocat-wrapper">
    <label asp-for="Type" class="ocat-label">@T["Type"]</label>
    <div class="ocat-end">
        <select asp-for="Type" class="form-select content-preview-select field-type-select-menu">
            <option value="text">@T["Text"]</option>
            <option value="number">@T["Number"]</option>
            <option value="email">@T["Email"]</option>
            <option value="tel">@T["Phone"]</option>
            <option value="password">@T["Password"]</option>
            <option value="url">@T["Url"]</option>
        </select>
        <span class="hint">@T["The input type."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Placeholder" class="ocat-label">@T["Placeholder Text"]</label>
    <div class="ocat-end">
        <input asp-for="Placeholder" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The text to display when the field has no value."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Value" class="ocat-label">@T["Value"]</label>
    <div class="ocat-end">
        <input asp-for="Value" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The value for this field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="AutoComplete" class="ocat-label">@T["AutoComplete Text"]</label>
    <div class="ocat-end">
        <input asp-for="AutoComplete" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The auto complete name attribute for this field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Prefix" class="ocat-label">@T["Prefix Text"]</label>
    <div class="ocat-end">
        <input asp-for="Prefix" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The text to display the prefix of the field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Prefix" class="ocat-label">@T["Suffix Text"]</label>
    <div class="ocat-end">
        <input asp-for="Suffix" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The text to display the suffix of the field."]</span>
    </div>
</div>

<fieldset class="mb-3" asp-validation-class-for="SpellCheck">
    <div class="form-check">
        <input asp-for="SpellCheck" class="form-check-input" type="checkbox" />
        <label asp-for="SpellCheck" class="form-check-label">@T["Enable spell check"]</label>
    </div>
    <span class="hint">@T["Whether input text to do perform spell check."]</span>
</fieldset>

<div class="ocat-wrapper">
    <label asp-for="SessionKey" class="ocat-label">@T["Session Key"]</label>
    <div class="ocat-end">
        <input asp-for="SessionKey" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The session key value where application store a value for this field."]</span>
    </div>
</div>
