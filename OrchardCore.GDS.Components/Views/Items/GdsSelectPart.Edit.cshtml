@using OrchardCore
@model GdsSelectPartViewModel

<div class="@Orchard.GetWrapperClasses()">
    <label asp-for="SessionKey" class="@Orchard.GetLabelClasses()">@T["Session Key"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input asp-for="SessionKey" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The session key value where application store a value for this field."]</span>
    </div>
</div>