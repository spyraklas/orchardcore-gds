@model GdsSelectPartViewModel

<div class="ocat-wrapper">
    <label asp-for="SessionKey" class="ocat-label">@T["Session Key"]</label>
    <div class="ocat-end">
        <input asp-for="SessionKey" type="text" class="form-control content-preview-text" />
        <span class="hint">@T["The session key value where application store a value for this field."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Autosave" class="ocat-label">@T["Autosave"]</label>
    <div class="ocat-end">
        <input asp-for="Autosave" class="form-check-input" type="checkbox" />
        <span class="hint">@T["Whether to automatically save the field value to the session."]</span>
    </div>
</div>