@using Microsoft.AspNetCore.Http
@using OrchardCore.GDS.Components.Config
@model BlobFilesEditPartViewModel
@inject IHttpContextAccessor httpContextAccessor

@{
    var fullUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
    var settings = Model.Settings;

    //set session variables to be used in the List, Upload, Download and Remove actions
    httpContextAccessor.HttpContext.Session.SetString(Constants.Files.SessionKey, Model.FileReference);
}

<div class="ol-file-manager"
     data-list-url="@Url.Content(Constants.Files.ListUrl)"
     data-upload-url="@Url.Content(Constants.Files.UploadUrl)"
     data-with-download="@settings.WithDownload"
     data-download-url="@Url.Content(Constants.Files.DownloadUrl)"
     data-with-remove="@settings.WithRemove"
     data-remove-url="@Url.Content(Constants.Files.RemoveUrl)"
     data-max-file-size="10485760">

    @Html.AntiForgeryToken()

    <div class="ol-file-manager__toolbar">
        <input type="file" class="ol-file-manager__input" />
        <button type="button" class="btn btn-primary ol-file-manager__upload">
            Upload
        </button>
    </div>

    <div class="ol-file-manager__message" role="status" aria-live="polite"></div>

    <div class="ol-file-manager__files">
        <p>Select a file or refresh the list.</p>
    </div>
</div>

<script asp-name="gds-file-manager" at="Foot"></script>









