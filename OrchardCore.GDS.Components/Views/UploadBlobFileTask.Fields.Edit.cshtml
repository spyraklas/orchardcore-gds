@using OrchardCore
@using OrchardCore.GDS.Components.Workflows.ViewModels
@model UploadBlobFileTaskViewModel

<div class="@Orchard.GetWrapperClasses()" asp-validation-class-for="SessionKey">
    <label asp-for="SessionKey" class="@Orchard.GetLabelClasses()">@T["Session Key"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input type="text" asp-for="SessionKey" class="form-control" />
        <span asp-validation-for="SessionKey"></span>
        <span class="hint">@T["The name of the session key variable."]</span>
    </div>
</div>

<div class="@Orchard.GetWrapperClasses()" asp-validation-class-for="FilePath">
    <label asp-for="FilePath" class="@Orchard.GetLabelClasses()">@T["File Path"]</label>
    <div class="@Orchard.GetEndClasses()">
        <input type="text" asp-for="FilePath" class="form-control" />
        <span asp-validation-for="FilePath"></span>
        <span class="hint">@T["The file path of the file."]</span>
    </div>
</div>
