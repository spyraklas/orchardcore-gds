@using OrchardCore
@using OrchardCore.GDS.Components.Workflows.ViewModels
@model CreateSessionUniqueReferenceTaskViewModel

<div class="ocat-wrapper" asp-validation-class-for="SessionKey">
    <label asp-for="SessionKey" class="ocat-label">@T["Session Key"]</label>
    <div class="ocat-end">
        <input type="text" asp-for="SessionKey" class="form-control" />
        <span asp-validation-for="SessionKey"></span>
        <span class="hint">@T["The name of the session key variable."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="SessionKey">
    <label asp-for="SessionKey" class="ocat-label">@T["Session Key"]</label>
    <div class="ocat-end">
        <input type="text" asp-for="SessionKey" class="form-control" />
        <span asp-validation-for="SessionKey"></span>
        <span class="hint">@T["The name of the session key variable."]</span>
    </div>
</div>
